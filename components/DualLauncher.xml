<?xml version="1.0" encoding="utf-8"?>
<component name="DualLauncher" extends="Group">
  <interface>
    <field id="launchRequest" type="string" alwaysNotify="true" />
    <field id="status" type="string" />
    <function name="ShowMenu" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/DualLauncher.brs" />
  <children>
    <Group id="menu" visible="true">
      <Rectangle width="1920" height="1080" color="0x09090BFF" />
      <Label id="heading" translation="[180,170]" width="1560" height="100" text="ROKU PLUS" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="subheading" translation="[180,280]" width="1560" height="60" text="Selecciona tu experiencia" color="0xB8C0CCFF" font="font:MediumSystemFont" />
      <Rectangle id="playletCard" translation="[180,410]" width="740" height="260" color="0x242B38FF" />
      <Rectangle id="plusCard" translation="[1000,410]" width="740" height="260" color="0x242B38FF" />
      <Label id="playletTitle" translation="[240,470]" width="620" height="80" text="PLAYLET" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="playletDesc" translation="[240,560]" width="620" height="55" text="YouTube · búsqueda · canales · biblioteca" color="0xB8C0CCFF" font="font:MediumSystemFont" />
      <Label id="plusTitle" translation="[1060,470]" width="620" height="80" text="ROKU PLUS" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="plusDesc" translation="[1060,560]" width="620" height="55" text="Películas · series · TV en vivo" color="0xB8C0CCFF" font="font:MediumSystemFont" />
      <Label id="countdown" translation="[180,760]" width="1560" height="55" text="Abriendo tu última aplicación en 10 segundos..." color="0xFFFFFFFF" font="font:MediumSystemFont" />
      <Label id="hint" translation="[180,850]" width="1560" height="50" text="↑ / ↓ cambiar   ·   OK abrir   ·   * guardar predeterminada   ·   Cualquier tecla cancela el inicio automático" color="0xB8C0CCFF" font="font:SmallSystemFont" />
      <Label id="error" translation="[180,930]" width="1560" height="55" color="0xFF7777FF" font="font:SmallSystemFont" />
    </Group>
    <Group id="playletContainer" visible="false">
      <Group id="MainSceneContainer" />
    </Group>
    <DualLoadingIndicator id="PlayletLoadingIndicator" visible="false" />
    <Timer id="countdownTimer" duration="1" repeat="true" />
    <Timer id="playletLayoutTimer" duration="0.5" repeat="true" />
  </children>
</component>
